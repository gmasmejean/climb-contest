# Configuration de PRODUCTION (Lot 22). À copier sur le VPS en
# /opt/climbcontest/.env, puis `chmod 600 .env`. Ce fichier n'est jamais
# versionné ni envoyé par la CI : les secrets ne quittent pas le serveur.
# Procédure complète : docs/EXPLOITATION.md § Déploiement automatique.

# Version déployée — écrite par deploy.sh, ne la modifiez pas à la main.
IMAGE_TAG=

# Nom de domaine servi par Caddy, sans https:// (certificat obtenu seul).
SITE_ADDRESS=climb.example.fr
# Même domaine, avec https:// — liens des e-mails et origine CORS autorisée.
PUBLIC_APP_URL=https://climb.example.fr

# Base de données. Mot de passe : openssl rand -hex 24
POSTGRES_USER=climbcontest
POSTGRES_PASSWORD=
POSTGRES_DB=climbcontest

# Secrets de signature des jetons (au moins 32 caractères, deux valeurs
# DIFFÉRENTES). Générez chacun avec : openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_JUDGE_SECRET=

# Envoi des e-mails (vérification de compte, invitations des juges).
# Exemple Brevo : port 587 en STARTTLS, donc SMTP_SECURE=false (le chiffrement
# est négocié après connexion ; `true` est réservé au port 465).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Adresse d'expédition, sur le domaine authentifié chez le fournisseur SMTP.
MAIL_FROM="ClimbContest <no-reply@climb.example.fr>"

# Taille maximale d'une vidéo de voie, en octets (200 Mio).
VIDEO_MAX_BYTES=209715200

# Sauvegarde automatique : un pg_dump toutes les 6 h, 28 conservés.
BACKUP_INTERVAL_SECONDS=21600
BACKUP_KEEP=28
