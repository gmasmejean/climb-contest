# Copier ce fichier en `.env` (même dossier) avant `docker compose up`.

# Base de données
POSTGRES_USER=climbcontest
POSTGRES_PASSWORD=changez-moi
POSTGRES_DB=climbcontest
POSTGRES_PORT=5432

# Interface web de Mailpit (dev/test — aucun e-mail réel n'est jamais envoyé)
MAILPIT_UI_PORT=8025

# Port HTTP exposé par Caddy (le point d'entrée unique de l'application)
HTTP_PORT=8080

# URL publique de l'application — utilisée pour construire les liens dans
# les e-mails (vérification, invitation). En local avec les ports par
# défaut : http://localhost:8080
PUBLIC_APP_URL=http://localhost:8080

# Secret de signature des jetons d'accès organisateur (JWT, HS256).
# Générez une valeur aléatoire d'au moins 32 caractères, par exemple :
#   openssl rand -base64 32
JWT_ACCESS_SECRET=changez-moi-au-moins-32-caracteres-aleatoires

# Secret de signature des jetons d'accès juge (JWT, HS256) — distinct du
# précédent : les deux portées ne doivent jamais se mélanger.
JWT_JUDGE_SECRET=changez-moi-aussi-au-moins-32-caracteres

# Adresse d'expédition des e-mails (vérification, invitation)
MAIL_FROM=no-reply@climbcontest.example

# Taille maximale d'une vidéo de voie téléversée, en octets (par défaut
# 209715200 = 200 Mio, au plus 2000000000). Les vidéos sont stockées sur le
# volume `uploads-data` : à inclure dans vos sauvegardes.
VIDEO_MAX_BYTES=209715200

# UNIQUEMENT pour lancer la suite e2e complète : relève le plafond des routes
# d'authentification (10 essais / 15 min / adresse) que ses ~15 connexions
# dépassent. Laissez vide en production.
AUTH_RATE_LIMIT_MAX=

# Sauvegarde automatique (profil `backup`, voir docker-compose.yml) : un
# pg_dump toutes les 6 h (21600 s), 28 fichiers conservés.
BACKUP_INTERVAL_SECONDS=21600
BACKUP_KEEP=28
